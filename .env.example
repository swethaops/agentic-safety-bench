# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Provider selection ────────────────────────────────────────────────────────
# Set LLM_PROVIDER to "anthropic" (default), "openai", or "azure"
# LLM_PROVIDER=anthropic

# ── Anthropic ─────────────────────────────────────────────────────────────────
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Model override (default: claude-haiku-5-5 for iteration)
# Set to claude-sonnet-5-5 for the final published experiment
# ANTHROPIC_MODEL=claude-sonnet-5-5

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Get your key at https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# Model override (default: gpt-4o-mini for iteration)
# Set to gpt-4o for the final published experiment
# OPENAI_MODEL=gpt-4o

# ── Azure OpenAI ──────────────────────────────────────────────────────────────
# LLM_PROVIDER=azure
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/openai/v1
# AZURE_OPENAI_API_KEY=<your-azure-key>
# Deployment name — must match the name you used when deploying the model in Azure AI Foundry
# AZURE_OPENAI_DEPLOYMENT=gpt-4.1-nano
